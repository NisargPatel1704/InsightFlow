# Copy this file to .env and adjust values for your environment.
# Flask will not read this automatically unless you use `python-dotenv`
# (already a dependency) — run.py can be extended to call load_dotenv()
# if you want automatic loading.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///instance/insightflow.db
